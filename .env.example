# Copy to .env (git-ignored) for local development. Never commit real keys.

# --- Model endpoints (OpenAI-compatible). Leave the mock values to use tools/mock-openai. ---
CHAT_BASE_URL=http://localhost:4010/v1
CHAT_MODEL=mock-chat
CHAT_API_KEY=
EMBEDDINGS_BASE_URL=http://localhost:4010/v1
EMBEDDINGS_MODEL=mock-embeddings
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMENSIONS=1024

# --- PostgreSQL (docker compose: `pnpm db:up`) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=docs_platform
PGUSER=docs
PGPASSWORD=docs
PGSSLMODE=disable

# --- API ---
PORT=8080
PLATFORM_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
AUTH_MODE=trusted-header
AUTH_SUBJECT_HEADER=x-auth-request-user
AUTH_EMAIL_HEADER=x-auth-request-email
AUTH_GROUPS_HEADER=x-auth-request-groups
AUTH_ADMIN_GROUPS=docs-admins
# Local dev only; production runs migrations from the Helm migration Job.
DB_MIGRATE_ON_START=true
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_MAX_CONCURRENT_STREAMS_PER_USER=2

# --- Source / publishing ---
SOURCE_GIT_URL=./examples/sample-docs
SOURCE_BRANCH=main
DATA_DIR=./.data
WEBHOOK_ENABLED=false
WEBHOOK_PROVIDER=gitea
WEBHOOK_SECRET=
