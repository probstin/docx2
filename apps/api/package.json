{
  "name": "@docs-platform/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify platform API: chat, identity, admin, webhooks, scheduler",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js"
  },
  "main": "./dist/main.js",
  "devDependencies": {
    "pino": "10.4.0"
  },
  "dependencies": {
    "@docs-platform/auth": "workspace:*",
    "@docs-platform/contracts": "workspace:*",
    "fastify": "5.12.7",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  }
}
