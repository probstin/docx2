{
  "name": "@docs-platform/chat-react",
  "version": "0.0.0",
  "private": true,
  "description": "Shared chat widget and full-screen assistant",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
